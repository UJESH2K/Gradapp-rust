{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GradApp",
  "version": "2.0.2",
  "identifier": "com.ujesh.gradapp",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GradApp",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#07080b",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Pool the GPUs around you into one training mesh.",
    "copyright": "Copyright (c) 2026 Ujesh Kumar Yadav",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "../../desktop/engine/*.py": "engine/",
      "../../desktop/engine/*.txt": "engine/",
      "../../desktop/engine/coordinator/*.py": "engine/coordinator/",
      "../ui/logo.png": "assets/logo.png"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/UJESH2K/gradapp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3QzJDRTg0MEU2QUQyNzgKUldSNDBtb09oTTdDbDB4UEgxWkEvTmE2RVNGeEN5WThuY1BUMHVUdUF2b1NtQU8rdVY1OUE1TE0K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
